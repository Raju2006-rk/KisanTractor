{
  "name": "@kisantractor/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "env:check": "tsx src/cli.ts",
    "release:check": "tsx src/readiness-cli.ts"
  },
  "dependencies": {
    "@kisantractor/providers": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@kisantractor/test-utils": "workspace:*",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
