CONFIG_VERSION=1
APP_ENV=production
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4000
PUBLIC_WEB_ORIGIN=https://kisantractor.example
PUBLIC_API_ORIGIN=https://api.kisantractor.example
DATABASE_URL=postgresql://USER:PASSWORD@PRODUCTION_DATABASE_HOST:5432/kisantractor
LOG_LEVEL=info
# none keeps spans/metrics in process; stdout writes JSON lines for a collector.
TELEMETRY_EXPORTER=none
ENABLE_PWA=true

# Set a capability to LIVE only after its provider readiness checks pass.
OTP_CAPABILITY_STATE=UNCONFIGURED
MAPS_CAPABILITY_STATE=UNCONFIGURED
PAYMENT_CAPABILITY_STATE=UNCONFIGURED
MESSAGING_CAPABILITY_STATE=UNCONFIGURED
STORAGE_CAPABILITY_STATE=UNCONFIGURED
TELEPHONY_CAPABILITY_STATE=UNCONFIGURED
# Dedicated IVR booking number (E.164). Shown publicly only while telephony is LIVE.
TELEPHONY_BOOKING_NUMBER=
# Online payment adapter: none or razorpay. A rzp_test_ key runs SANDBOX (never in production);
# a rzp_live_ key runs LIVE (staging/production only, after readiness checks pass).
PAYMENT_PROVIDER=none
RAZORPAY_KEY_ID=
# Secrets come from the secret store at runtime; never commit values.
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Messaging adapters (MESSAGING capability). SMS: none or msg91 (DLT-registered templates via the
# MSG91 Flow API). Push: none or fcm (Firebase Cloud Messaging HTTP v1). SANDBOX never sends
# (MSG91 is not called; FCM validate_only) and is refused in production; LIVE is staging/production
# only. See ops/runbooks/messaging.md.
SMS_PROVIDER=none
PUSH_PROVIDER=none
# JSON map {"notification.<name>@<version>:<locale>": "<MSG91 template id>"}; per environment, never in code.
MSG91_TEMPLATE_IDS=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_EMAIL=
# Secrets come from the secret store at runtime; never commit values.
MSG91_AUTH_KEY=
FCM_SERVICE_ACCOUNT_PRIVATE_KEY=
# Phase 2 switch for consent-aware Owner contact sharing (booking Farmer only, Owner consent required).
ENABLE_OWNER_CONTACT_SHARING=false
# Phase 2 switch for support dispute workflows; false keeps the deny-all support access policy.
ENABLE_SUPPORT_WORKFLOWS=false

# Production validation rejects true for every development-only bypass.
ALLOW_LOCAL_OTP_CODES=false
ALLOW_UNSIGNED_PROVIDER_CALLBACKS=false
ALLOW_FAKE_PHONE_NUMBERS=false
ALLOW_TEST_PAYMENT_SUCCESS=false
